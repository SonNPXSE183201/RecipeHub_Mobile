rules_version = '2';

// RecipeHub mobile – Cloud Storage rules
// - Chỉ người dùng đã đăng nhập (kể cả Anonymous) được ghi.
// - Cô lập theo uid: chỉ chủ sở hữu đọc / tạo / xóa thư mục của mình.
// - feedback/: ảnh PNG / JPEG / WEBP / HEIC tối đa 5 MB (không nhận SVG – có thể chứa script).
// - reports/: chỉ PDF tối đa 5 MB.
// - delete tách riêng vì khi xóa request.resource là null.
service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function underLimit() { return request.resource.size < 5 * 1024 * 1024; }

    // Admin cửa hàng (claim role = admin) xem ảnh đính kèm phản hồi của mọi Barista.
    match /feedback/{uid}/{allPaths=**} {
      allow read: if owner(uid) || (request.auth != null && request.auth.token.role == 'admin');
      allow delete: if owner(uid);
      allow create, update: if owner(uid) && underLimit()
                            && request.resource.contentType.matches('image/(png|jpeg|jpg|webp|heic|heif)');
    }

    match /reports/{uid}/{allPaths=**} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && underLimit()
                            && request.resource.contentType == 'application/pdf';
    }

    // Tài liệu SOP: mọi người dùng đăng nhập được đọc, không ai ghi từ app.
    match /sop/{file} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Video hướng dẫn món: Admin tải lên từ web (MP4 ≤ 100 MB), mọi tài khoản đăng nhập xem.
    match /recipe-videos/{code}/{file} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.token.role == 'admin'
                            && request.resource.size < 100 * 1024 * 1024
                            && request.resource.contentType == 'video/mp4';
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
